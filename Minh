-- 2. LOGIC TÌM QUÁI VÀ AUTO FARM
-- ==========================================

-- Hàm lấy quái vật gần nhất theo tên
local function getNearestMob(mobName)
    local nearestMob = nil
    local shortestDistance = math.huge
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")

    -- Blox Fruits thường lưu quái vật trong thư mục workspace.Enemies
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    for _, mob in pairs(enemiesFolder:GetChildren()) do
        if mob.Name == mobName and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
            if mobRoot then
                local distance = (rootPart.Position - mobRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestMob = mob
                end
            end
        end
    end
    return nearestMob
end

-- Hàm trang bị vũ khí (Melee hoặc Kiếm)
local function equipWeapon()
    local character = player.Character
    if not character then return end

    -- Tìm vũ khí trong Backpack và trang bị nó
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            -- Tùy chỉnh ưu tiên vũ khí nếu cần
            character.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- Vòng lặp chính cho Auto Farm
task.spawn(function()
    while task.wait() do
        if autoFarmEnabled then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local targetMob = getNearestMob(selectedMobName)

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    -- 1. Dịch chuyển (Teleport/CFrame) đến sau lưng quái vật để tránh sát thương
                    local mobRoot = targetMob.HumanoidRootPart
                    rootPart.CFrame = mobRoot.CFrame * CFrame.new(0, 5, 5) -- Đứng trên và phía sau 5 stud

                    -- 2. Đóng băng nhân vật trên không (Tùy chọn: giúp không bị rớt)
                    rootPart.Velocity = Vector3.new(0, 0, 0)

                    -- 3. Trang bị vũ khí
                    equipWeapon()

                    -- 4. Tấn công (Mô phỏng click chuột)
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0,0))
                end
            end
        end
    end
end)

